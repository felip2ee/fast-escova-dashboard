# Conexao usada somente pelo servidor. Nunca use prefixo VITE_ nesta variavel.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Este PostgreSQL nao utiliza TLS.
DATABASE_SSL=disable

# Conexao somente leitura com o PostgreSQL do Chatwoot.
CHATWOOT_DATABASE_URL=postgresql://usuario_leitura:senha@host:5432/chatwoot
CHATWOOT_DATABASE_SSL=disable
CHATWOOT_ACCOUNT_ID=2
CHATWOOT_INBOX_ID=1

# Banco PostgreSQL isolado usado somente pela suite de integracao.
TEST_DATABASE_URL=postgresql://postgres:senha@localhost:5432/fast_dashboard_test
